{
  "name": "mqr",
  "version": "1.1.0",
  "description": "MQr - Lector y creador de códigos QR multiplataforma de MSoft",
  "author": "MSoft",
  "license": "MIT",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable",
    "dist:installer": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac --zip",
    "test": "node tests/core.test.js"
  },
  "dependencies": {
    "html5-qrcode": "2.3.8",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "es.msof.mqr",
    "productName": "MQr",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "desktop/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MQr",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "${productName}-${version}-x64-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-x64-portable.${ext}"
    },
    "linux": {
      "category": "Utility",
      "target": [
        { "target": "AppImage", "arch": ["x64", "arm64"] },
        { "target": "tar.gz", "arch": ["x64", "arm64"] }
      ]
    },
    "mac": {
      "category": "public.app-category.utilities",
      "identity": null,
      "target": [
        { "target": "zip", "arch": ["x64", "arm64"] }
      ]
    }
  }
}
