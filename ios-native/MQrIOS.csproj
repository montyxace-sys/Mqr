<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MQrIOS</RootNamespace>
    <AssemblyName>MQrIOS</AssemblyName>
    <ApplicationTitle>MQr</ApplicationTitle>
    <BundleIdentifier>es.msof.mqr</BundleIdentifier>
    <ApplicationDisplayVersion>1.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <ItemGroup>
    <BundleResource Include="..\app\**\*.*" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
